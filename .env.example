# Copy this file to .env only if you do not already have a configured .env.
# Backend and worker always load .env beside backend_api.py, not shell cwd.
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Selected backend transport. No recipient allowlist; each user verifies their own address.
EMAIL_PROVIDER=gmail
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
# Optional Gmail API OAuth instead: EMAIL_PROVIDER=gmail_oauth
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Conservative app budget below Gmail's own quota.
EMAIL_DAILY_LIMIT=100
# Retained alternative: EMAIL_PROVIDER=resend
RESEND_API_KEY=
# For testing with your Resend account recipient:
EMAIL_FROM=onboarding@resend.dev
# The Resend test sender restricts recipients. Use Gmail for dynamic recipients without a custom domain.
# Browser key: restrict websites to localhost/127.0.0.1 at the actual port.
# Enable and API-restrict it to Maps JavaScript API + Places API (New).
GOOGLE_MAPS_BROWSER_KEY=
WEARABLE_INGEST_KEY=
# Optional absolute DB path. Leave unset for this project's instance/shesync.sqlite3.
# SHESYNC_DB=C:/absolute/project/instance/shesync.sqlite3
PORT=5000
